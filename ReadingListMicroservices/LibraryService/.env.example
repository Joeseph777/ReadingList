# Copy this file to .env and fill in real values before deploying.
# Never commit the real .env file.

DATABASE_URL=sqlite:///./data/library.db

# MUST be the exact same value as SECRET_KEY in AuthService/.env — this is what
# lets LibraryService verify the login tokens AuthService issues. If these two
# don't match, every request will fail with "Could not validate credentials".
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_VALUE

# Where AuthService lives, from LibraryService's point of view (used to verify
# friendships before sharing a reading list). In docker-compose, this is the
# service name — leave as-is unless you rename the service in docker-compose.yml.
AUTH_SERVICE_URL=http://auth:8000

# See the matching note in AuthService/.env.example.
ALLOWED_ORIGINS=*
