# Copy this file to .env and fill in real values before deploying.
# Never commit the real .env file.

DATABASE_URL=sqlite:///./data/auth.db

# Generate a real one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_VALUE

# Where LibraryService lives, from AuthService's point of view. In docker-compose,
# this is the service name — leave as-is unless you rename the service in
# docker-compose.yml.
LIBRARY_SERVICE_URL=http://library:8001

# Password reset emails. Leave SMTP_HOST empty for local testing — reset links
# will just print to the server console instead of being emailed. Fill these in
# with a real provider (Gmail app password, SES, Mailgun, etc.) before deploying
# for real, or "forgot password" won't actually reach anyone.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
# Public URL of the web app — used to build the link inside reset emails.
FRONTEND_URL=http://localhost:5500

# Your real domain(s), comma-separated, no trailing slash. Example:
# ALLOWED_ORIGINS=https://readinglist.example.com
# Only relevant if you're calling this API from a different origin than the one
# nginx serves the web app from — the docker-compose setup in this repo serves
# everything from one origin via nginx, so this can usually stay "*" even in
# production. Tighten it if you ever split the frontend onto its own domain/CDN.
ALLOWED_ORIGINS=*

# There is deliberately no admin code here anymore. To create your first admin:
# register a normal account through the app, then run, with server access:
#   cd AuthService && python bootstrap_admin.py <your-username>
# After that, existing admins can promote/revoke others from the Users page.
